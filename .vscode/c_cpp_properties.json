{
	"version": 4,
	"configurations": [
		{
			"name": "Linux - Debug (GCC)",
			"compileCommands": "${workspaceFolder}/build/linux-debug-gcc/compile_commands.json",
			"defines": [
				"DEBUG",
				"GLFW_INCLUDE_NONE",
				"LOGGING_ENABLED",
				"ASSERTS_ENABLED"
			],
			"compilerPath": "/usr/bin/g++",
			"cStandard": "c17",
			"cppStandard": "c++17",
			"intelliSenseMode": "linux-gcc-x64"
		},
		{
			"name": "Linux - Debug (Clang)",
			"compileCommands": "${workspaceFolder}/build/linux-debug-clang/compile_commands.json",
			"defines": [
				"DEBUG",
				"GLFW_INCLUDE_NONE",
				"LOGGING_ENABLED",
				"ASSERTS_ENABLED"
			],
			"compilerPath": "/usr/bin/clang++",
			"cStandard": "c17",
			"cppStandard": "c++17",
			"intelliSenseMode": "linux-clang-x64"
		}
	]
}
